<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         AEROBOT ULTIMATE EDITION - DARK THEME PALETTE (Default)
         High-contrast dark surfaces, neon accents, and crisp typography
         ========================================================================= -->

    <!-- Surfaces & Windows -->
    <Color x:Key="Color.Window.Background">#0F141C</Color>
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0F141C" />

    <!-- Card Backgrounds & Borders -->
    <Color x:Key="Color.Card.Background">#18202C</Color>
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#18202C" />

    <Color x:Key="Color.Card.Background.Secondary">#1E2636</Color>
    <SolidColorBrush x:Key="Brush.Card.Background.Secondary" Color="#1E2636" />

    <Color x:Key="Color.Card.Background.Tertiary">#242E40</Color>
    <SolidColorBrush x:Key="Brush.Card.Background.Tertiary" Color="#242E40" />

    <Color x:Key="Color.Card.Border">#2A3547</Color>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#2A3547" />

    <Color x:Key="Color.Card.Border.Subtle">#202A38</Color>
    <SolidColorBrush x:Key="Brush.Card.Border.Subtle" Color="#202A38" />

    <Color x:Key="Color.Card.Border.Hover">#3B82F6</Color>
    <SolidColorBrush x:Key="Brush.Card.Border.Hover" Color="#3B82F6" />

    <!-- Typography / Text Colors -->
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F8FAFC" />

    <Color x:Key="Color.Text.Secondary">#94A3B8</Color>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#94A3B8" />

    <Color x:Key="Color.Text.Muted">#64748B</Color>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#64748B" />

    <Color x:Key="Color.Text.Inverse">#0F172A</Color>
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#0F172A" />

    <!-- Input Controls (TextBox, ComboBox, Steppers) -->
    <Color x:Key="Color.Control.Background">#121822</Color>
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#121822" />

    <Color x:Key="Color.Control.Background.Hover">#1A2230</Color>
    <SolidColorBrush x:Key="Brush.Control.Background.Hover" Color="#1A2230" />

    <Color x:Key="Color.Control.Border">#334155</Color>
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#334155" />

    <Color x:Key="Color.Control.Border.Hover">#475569</Color>
    <SolidColorBrush x:Key="Brush.Control.Border.Hover" Color="#475569" />

    <Color x:Key="Color.Control.Border.Focus">#3B82F6</Color>
    <SolidColorBrush x:Key="Brush.Control.Border.Focus" Color="#3B82F6" />

    <Color x:Key="Color.Control.Foreground">#F8FAFC</Color>
    <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#F8FAFC" />

    <Color x:Key="Color.Control.Placeholder">#64748B</Color>
    <SolidColorBrush x:Key="Brush.Control.Placeholder" Color="#64748B" />

    <!-- Neutral Button Surface & Border -->
    <SolidColorBrush x:Key="Brush.Button.Background" Color="#1E2636" />
    <SolidColorBrush x:Key="Brush.Button.Foreground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.Button.Border" Color="#2A3547" />

    <!-- Brand & Accent Colors -->
    <Color x:Key="Color.Primary">#2563EB</Color>
    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB" />

    <Color x:Key="Color.Primary.Hover">#1D4ED8</Color>
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="#1D4ED8" />

    <Color x:Key="Color.Primary.Active">#1E40AF</Color>
    <SolidColorBrush x:Key="Brush.Primary.Active" Color="#1E40AF" />

    <Color x:Key="Color.Primary.Subtle">#1E2E4A</Color>
    <SolidColorBrush x:Key="Brush.Primary.Subtle" Color="#1E2E4A" />

    <!-- Status Colors -->
    <Color x:Key="Color.Success">#10B981</Color>
    <SolidColorBrush x:Key="Brush.Success" Color="#10B981" />

    <Color x:Key="Color.Success.Hover">#059669</Color>
    <SolidColorBrush x:Key="Brush.Success.Hover" Color="#059669" />

    <Color x:Key="Color.Success.Subtle">#13332B</Color>
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#13332B" />

    <Color x:Key="Color.Warning">#F59E0B</Color>
    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B" />

    <Color x:Key="Color.Warning.Hover">#D97706</Color>
    <SolidColorBrush x:Key="Brush.Warning.Hover" Color="#D97706" />

    <Color x:Key="Color.Warning.Subtle">#3A2C19</Color>
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#3A2C19" />

    <Color x:Key="Color.Danger">#EF4444</Color>
    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444" />

    <Color x:Key="Color.Danger.Hover">#DC2626</Color>
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#DC2626" />

    <Color x:Key="Color.Danger.Subtle">#3A1C20</Color>
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#3A1C20" />

    <Color x:Key="Color.Purple">#8B5CF6</Color>
    <SolidColorBrush x:Key="Brush.Purple" Color="#8B5CF6" />

    <Color x:Key="Color.Purple.Hover">#7C3AED</Color>
    <SolidColorBrush x:Key="Brush.Purple.Hover" Color="#7C3AED" />

    <Color x:Key="Color.Purple.Subtle">#2E2248</Color>
    <SolidColorBrush x:Key="Brush.Purple.Subtle" Color="#2E2248" />

    <!-- Badges & Chips -->
    <Color x:Key="Color.Badge.Background">#1F2937</Color>
    <SolidColorBrush x:Key="Brush.Badge.Background" Color="#1F2937" />

    <Color x:Key="Color.Badge.Border">#374151</Color>
    <SolidColorBrush x:Key="Brush.Badge.Border" Color="#374151" />

    <!-- Gauges & Progress Bars -->
    <Color x:Key="Color.Gauge.Track">#111620</Color>
    <SolidColorBrush x:Key="Brush.Gauge.Track" Color="#111620" />

    <!-- CheckBox Glyphs & Boxes -->
    <SolidColorBrush x:Key="Brush.CheckBox.Box.Background" Color="#121822" />
    <SolidColorBrush x:Key="Brush.CheckBox.Box.Border" Color="#334155" />
    <SolidColorBrush x:Key="Brush.CheckBox.Glyph" Color="#FFFFFF" />

    <!-- Shadows & Glows -->
    <DropShadowEffect x:Key="Effect.Card.Shadow" 
                      BlurRadius="16" 
                      Direction="270" 
                      ShadowDepth="2" 
                      Opacity="0.25" 
                      Color="#000000" />

    <DropShadowEffect x:Key="Effect.Glow.Primary" 
                      BlurRadius="10" 
                      Direction="0" 
                      ShadowDepth="0" 
                      Opacity="0.4" 
                      Color="#3B82F6" />

    <DropShadowEffect x:Key="Effect.Glow.Danger" 
                      BlurRadius="10" 
                      Direction="0" 
                      ShadowDepth="0" 
                      Opacity="0.35" 
                      Color="#EF4444" />

    <DropShadowEffect x:Key="Effect.Text.Shadow" 
                      BlurRadius="4" 
                      Direction="270" 
                      ShadowDepth="1" 
                      Opacity="0.6" 
                      Color="#000000" />

    <!-- =========================================================================
         STANDARD THEME BRUSH ALIASES (DynamicResource Compatible)
         ========================================================================= -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#18202C" />
    <SolidColorBrush x:Key="SurfaceBrush.Secondary" Color="#1E2636" />
    <SolidColorBrush x:Key="SurfaceBrush.Tertiary" Color="#242E40" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3547" />
    <SolidColorBrush x:Key="BorderBrush.Subtle" Color="#202A38" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E2E4A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1A2230" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1E2636" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2A3547" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListBoxBackgroundBrush" Color="#18202C" />
    <SolidColorBrush x:Key="ListBoxBorderBrush" Color="#2A3547" />

</ResourceDictionary>
