<UserControl x:Class="RSBot.General.Views.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, 'Segoe UI Arabic', 'Inter', Arial"
             Background="{DynamicResource Brush.Window.Background}"
             Foreground="{DynamicResource Brush.Text.Primary}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeResources.xaml" />
                <ResourceDictionary Source="DarkThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main Outer Container with Smooth Scrolling -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="18,14,18,24">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Statistics & Resource Bar (Header Area) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Executable & Client Path Selection Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: 2-Column Responsive Workspace Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!-- =========================================================================
                 ROW 0: TOP STATISTICS & RESOURCE BAR (HEADER AREA)
                 Progression Bars (HP, MP) & Character Vitals / Currency Chips
                 ========================================================================= -->
            <Border Grid.Row="0" 
                    Style="{StaticResource Style.Card}" 
                    Margin="0,0,0,14" 
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: HP & MP Horizontal Progression Gauges -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <!-- HP Progress Bar -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <!-- MP Progress Bar -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- HP Gauge -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="8" Height="8" Background="#EF4444" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="نقاط الصحة (HP):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" HorizontalAlignment="Left" 
                                           FlowDirection="LeftToRight"
                                           FontSize="11.5" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}">
                                    <Run Text="100.00%" Foreground="#EF4444" />
                                    <Run Text=" (45,210 / 45,210)" />
                                </TextBlock>
                            </Grid>

                            <!-- HP Progress Bar Track -->
                            <Border Grid.Row="1" 
                                    Height="18" 
                                    Background="{DynamicResource Brush.Gauge.Track}" 
                                    BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- Animated / Filled Bar -->
                                    <ProgressBar Value="100" 
                                                 Maximum="100" 
                                                 Height="18"
                                                 Foreground="{StaticResource Brush.HP.Gradient}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FlowDirection="LeftToRight" />
                                    <!-- Center Percentage Label -->
                                    <TextBlock Text="100.00%" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               FontSize="11" 
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Effect="{StaticResource Effect.Text.Shadow}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- MP Gauge -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="8" Height="8" Background="#38BDF8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="نقاط السحر (MP):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" HorizontalAlignment="Left" 
                                           FlowDirection="LeftToRight"
                                           FontSize="11.5" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}">
                                    <Run Text="100.00%" Foreground="#38BDF8" />
                                    <Run Text=" (32,450 / 32,450)" />
                                </TextBlock>
                            </Grid>

                            <!-- MP Progress Bar Track -->
                            <Border Grid.Row="1" 
                                    Height="18" 
                                    Background="{DynamicResource Brush.Gauge.Track}" 
                                    BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <ProgressBar Value="100" 
                                                 Maximum="100" 
                                                 Height="18"
                                                 Foreground="{StaticResource Brush.MP.Gradient}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FlowDirection="LeftToRight" />
                                    <TextBlock Text="100.00%" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               FontSize="11" 
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Effect="{StaticResource Effect.Text.Shadow}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom Row: Character Vitals & Currency Chips (STR, INT, Gold, SP) -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource Brush.Card.Background.Secondary}" 
                            BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- STR Chip -->
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <!-- INT Chip -->
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <!-- Gold Chip -->
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1" />
                                <!-- SP Chip -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- STR -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#2563EB" CornerRadius="4" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="STR:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtStrValue" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{DynamicResource Brush.Card.Border}" Width="1" Margin="4,2" />

                            <!-- INT -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#0284C7" CornerRadius="4" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock Text="I" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="INT:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtIntValue" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Rectangle Grid.Column="3" Fill="{DynamicResource Brush.Card.Border}" Width="1" Margin="4,2" />

                            <!-- Gold -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#D97706" CornerRadius="4" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="الذهب (Gold):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtGoldValue" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                            </StackPanel>

                            <Rectangle Grid.Column="5" Fill="{DynamicResource Brush.Card.Border}" Width="1" Margin="4,2" />

                            <!-- SP -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#7C3AED" CornerRadius="4" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock Text="P" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="المهارة (SP):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtSpValue" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Purple}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>


            <!-- =========================================================================
                 ROW 1: EXECUTABLE & CLIENT PATH SELECTION (FULL-WIDTH TOP CARD)
                 Path label, File Path TextBox, Region ComboBox, Browse Button, Version tag
                 ========================================================================= -->
            <Border Grid.Row="1" 
                    Style="{StaticResource Style.Card}" 
                    Margin="0,0,0,14" 
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Path Label -->
                        <ColumnDefinition Width="Auto" />
                        <!-- File Path TextBox -->
                        <ColumnDefinition Width="*" />
                        <!-- Region / Server ComboBox -->
                        <ColumnDefinition Width="150" />
                        <!-- Browse Button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Version Tag -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Path Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="{StaticResource Icon.Folder}" 
                              Fill="{DynamicResource Brush.Primary}" 
                              Width="15" Height="15" 
                              Stretch="Uniform" 
                              Margin="0,0,6,0" 
                              VerticalAlignment="Center" />
                        <TextBlock Text="مسار ملف سيلكرود التنفيذي:" 
                                   FontWeight="SemiBold" 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- File Path TextBox (Bound to Dynamic Resources with LTR text) -->
                    <TextBox x:Name="TxtSilkroadPath" 
                             Grid.Column="1" 
                             Style="{StaticResource Style.TextBox}"
                             Text="D:\silkroad\Legacy\Legacy\sro_client.exe"
                             FlowDirection="LeftToRight"
                             VerticalAlignment="Center" 
                             Margin="0,0,10,0" />

                    <!-- Region / Server ComboBox -->
                    <ComboBox x:Name="CmbRegionServer" 
                              Grid.Column="2" 
                              Style="{StaticResource Style.ComboBox}"
                              SelectedIndex="0" 
                              VerticalAlignment="Center" 
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="Vietnam" IsSelected="True" />
                        <ComboBoxItem Content="Global (iSRO)" />
                        <ComboBoxItem Content="vSRO (Legacy)" />
                        <ComboBoxItem Content="TRSRO Official" />
                        <ComboBoxItem Content="BR Silkroad" />
                        <ComboBoxItem Content="Custom Server" />
                    </ComboBox>

                    <!-- Browse Button ("...") -->
                    <Button x:Name="BtnBrowsePath" 
                            Grid.Column="3" 
                            Style="{StaticResource Style.Button.Secondary}"
                            Width="38" 
                            Height="32" 
                            VerticalAlignment="Center" 
                            Margin="0,0,12,0"
                            ToolTip="تحديد مسار sro_client.exe">
                        <TextBlock Text="..." FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Button>

                    <!-- Version Tag Badge (Neatly Aligned to the Right/End) -->
                    <Border Grid.Column="4" 
                            Background="{DynamicResource Brush.Primary.Subtle}" 
                            BorderBrush="{DynamicResource Brush.Primary}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,4" 
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="VERSION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LblVersion" Text="v1.757" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- =========================================================================
                 ROW 2: BALANCED 2-COLUMN RESPONSIVE WORKSPACE GRID (MAIN BODY)
                 Left Column (Account & Auth) | Right Column (Automation, Queue, Target)
                 ========================================================================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Column 1: Account, Authentication & Behavior -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <!-- Column 2: Client Automation, Server Queue & Target Monitor -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- =====================================================================
                     COLUMN 1 (LEFT): Account, Authentication & Behavior
                     ===================================================================== -->
                <StackPanel Grid.Column="0">

                    <!-- CARD 1: AUTO-LOGIN & CREDENTIALS -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Primary.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Login}" Fill="{DynamicResource Brush.Primary}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="تسجيل الدخول التلقائي (Automated Login)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>
                            </Grid>

                            <!-- Master Auto-Login CheckBox -->
                            <CheckBox x:Name="ChkEnableAutoLogin" 
                                      Style="{StaticResource Style.CheckBox}"
                                      IsChecked="True" 
                                      Margin="0,0,0,12">
                                <TextBlock Text="تفعيل تسجيل الدخول التلقائي" FontWeight="SemiBold" />
                            </CheckBox>

                            <!-- Account & Character Selector Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Account Selector -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الحساب:" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbAccounts" Style="{StaticResource Style.ComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="abdosonek" IsSelected="True" />
                                        <ComboBoxItem Content="abdosonek2" />
                                        <ComboBoxItem Content="abdosonek3" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Character Selector -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="اللاعب:" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbCharacters" Style="{StaticResource Style.ComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="X_SONEK_X" IsSelected="True" />
                                        <ComboBoxItem Content="X_WOLVES_X" />
                                        <ComboBoxItem Content="X_PHANTOM_X" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Action Button: Edit Account ("تعديل") -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnEditAccount" 
                                            Style="{StaticResource Style.Button.Primary}"
                                            Height="32" 
                                            Padding="12,0" 
                                            ToolTip="تعديل بيانات الحسابات وإدارتها">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Edit}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="تعديل" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Captcha Bypass Sub-Card Section -->
                            <Border Style="{StaticResource Style.Card.Subtle}" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="تخطي الكابتشا (Captcha Bypass)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="كود الكابتشا الثابت:" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="TxtStaticCaptcha" 
                                                 Grid.Column="1" 
                                                 Style="{StaticResource Style.TextBox}"
                                                 FlowDirection="LeftToRight"
                                                 Text="1377" />
                                    </Grid>

                                    <!-- Captcha Bypass Checkbox with full text wrapping -->
                                    <CheckBox x:Name="ChkEnableStaticCaptcha" 
                                              Style="{StaticResource Style.CheckBox}">
                                        <TextBlock Text="تفعيل الإدخال الثابت للكابتشا - إختار هذا فقط لو الكابتشا لا تتغير مطلقا" 
                                                   Style="{StaticResource Style.SubText}" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>


                    <!-- CARD 2: LOGIN FLOW & CHARACTER PRIORITY SETTINGS -->
                    <!-- Eliminates orphaned floating controls -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,0">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Purple.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Clock}" Fill="{DynamicResource Brush.Purple}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="إعدادات تدفق الدخول والشخصيات (Login Flow)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>
                            </Grid>

                            <!-- Login Delay Row: CheckBox + NumericUpDown Stepper + Unit Label -->
                            <Border Style="{StaticResource Style.Card.Subtle}" Margin="0,0,0,10" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="ChkEnableLoginDelay" 
                                              Grid.Column="0" 
                                              Style="{StaticResource Style.CheckBox}"
                                              IsChecked="True" 
                                              VerticalAlignment="Center">
                                        <TextBlock Text="Enable login delay (تأخير الدخول)" FontWeight="Medium" />
                                    </CheckBox>

                                    <!-- Numeric Stepper Control (Decrements/Increments Delay Seconds) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                        <Button x:Name="BtnDelayMinus" Style="{StaticResource Style.StepperButton}" Content="-" Margin="0,0,2,0" />
                                        <TextBox x:Name="TxtLoginDelay" 
                                                 Style="{StaticResource Style.TextBox}" 
                                                 Text="7" 
                                                 Width="36" 
                                                 Height="28" 
                                                 TextAlignment="Center" 
                                                 Padding="2,2" 
                                                 Margin="0,0,2,0" />
                                        <Button x:Name="BtnDelayPlus" Style="{StaticResource Style.StepperButton}" Content="+" Margin="0,0,6,0" />
                                        <TextBlock Text="seconds" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Automation Toggles List -->
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkAutoStartBot" 
                                          Style="{StaticResource Style.CheckBox}"
                                          IsChecked="True" 
                                          Margin="0,0,0,8">
                                    <TextBlock Text="البدء التلقائي للبوت (Auto start bot)" />
                                </CheckBox>

                                <CheckBox x:Name="ChkUseReturnScroll" 
                                          Style="{StaticResource Style.CheckBox}"
                                          IsChecked="False" 
                                          Margin="0,0,0,8">
                                    <TextBlock Text="استخدام رسالة العودة (Use return scroll)" />
                                </CheckBox>

                                <CheckBox x:Name="ChkAutoHideClient" 
                                          Style="{StaticResource Style.CheckBox}"
                                          IsChecked="False" 
                                          Margin="0,0,0,8">
                                    <TextBlock Text="Auto Hide Client (إخفاء الكلينت تلقائياً)" />
                                </CheckBox>
                            </StackPanel>

                            <!-- Character Selection Mode: Modern Segmented Control -->
                            <Border Style="{StaticResource Style.Card.Subtle}" Margin="0,4,0,0" Padding="10,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCharAutoSelect" 
                                              Style="{StaticResource Style.CheckBox}"
                                              IsChecked="True" 
                                              Margin="0,0,0,8">
                                        <TextBlock Text="الاختيار التلقائي للشخصية (Auto Char Select)" FontWeight="SemiBold" />
                                    </CheckBox>

                                    <!-- Segmented Control Container (Replaces ambiguous circular dots!) -->
                                    <Border Background="{DynamicResource Brush.Card.Background.Tertiary}" 
                                            BorderBrush="{DynamicResource Brush.Card.Border}" 
                                            BorderThickness="1" 
                                            CornerRadius="7" 
                                            Padding="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Segment 1: Auto Select First -->
                                            <RadioButton x:Name="RadAutoSelectFirst" 
                                                         Grid.Column="0" 
                                                         GroupName="CharSelectMode"
                                                         Style="{StaticResource Style.SegmentedRadioButton}"
                                                         Content="Auto Select First" 
                                                         IsChecked="True" />

                                            <!-- Segment 2: Auto Select Higher -->
                                            <RadioButton x:Name="RadAutoSelectHigher" 
                                                         Grid.Column="1" 
                                                         GroupName="CharSelectMode"
                                                         Style="{StaticResource Style.SegmentedRadioButton}"
                                                         Content="Auto Select Higher" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- =====================================================================
                     COLUMN 2 (RIGHT): Client Automation, Server Queue & Target Monitor
                     ===================================================================== -->
                <StackPanel Grid.Column="2">

                    <!-- CARD 1: CLIENT PROCESS CONTROLS -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Success}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="بدء اللعبة وإعدادات الكلينت (Client Controls)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>
                            </Grid>

                            <!-- Grouped Action Buttons (2x2 Grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Button: بدء الكلينت (Start Client) -->
                                <Button x:Name="BtnStartClient" 
                                        Grid.Row="0" Grid.Column="0" 
                                        Style="{StaticResource Style.Button.Success}" 
                                        Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Play}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="بدء الكلينت" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Button: بدء بدون كلينت (Start Clientless) -->
                                <Button x:Name="BtnStartClientless" 
                                        Grid.Row="0" Grid.Column="2" 
                                        Style="{StaticResource Style.Button.Purple}" 
                                        Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Server}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="بدء بدون كلينت" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Button: ظهور الكلينت / إخفاء (Client Visibility) -->
                                <Button x:Name="BtnClientHideShow" 
                                        Grid.Row="2" Grid.Column="0" 
                                        Style="{StaticResource Style.Button.Primary}" 
                                        Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Eye}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="ظهور الكلينت" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Button: التحويل الى بدون كلينت (Go Clientless) -->
                                <Button x:Name="BtnGoClientless" 
                                        Grid.Row="2" Grid.Column="2" 
                                        Style="{StaticResource Style.Button.Warning}" 
                                        Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Stop}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="بدون كلينت" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Keep-Alive CheckBox -->
                            <CheckBox x:Name="ChkStayConnected" 
                                      Style="{StaticResource Style.CheckBox}"
                                      IsChecked="True" 
                                      Margin="0,0,0,8">
                                <TextBlock Text="البقاء متصل اذا تم قفل الكلينت فجأة" FontWeight="Medium" />
                            </CheckBox>

                            <!-- Helper Callout Banner with Proper Text-Wrapping -->
                            <Border Background="{DynamicResource Brush.Card.Background.Secondary}" 
                                    BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" 
                                          Data="{StaticResource Icon.Info}" 
                                          Fill="{DynamicResource Brush.Primary}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          Margin="0,2,8,0" 
                                          VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" 
                                               Text="إذا تم قفل البوت بسبب كراش سينتقل البوت الى وضع بدون كلينت ويستمر في عمله تلقائياً." 
                                               Style="{StaticResource Style.SubText}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>


                    <!-- CARD 2: SYSTEM TRAY & BACKGROUND AUTOMATION -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Primary.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Gear}" Fill="{DynamicResource Brush.Primary}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="إعدادات البوت (Bot Settings)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>
                            </Grid>

                            <!-- Tray CheckBox -->
                            <CheckBox x:Name="ChkBotTrayMinimized" 
                                      Style="{StaticResource Style.CheckBox}"
                                      IsChecked="True" 
                                      Margin="0,0,0,6">
                                <TextBlock Text="نقل البوت الى ايقونات النظام عند تصغيره الى شريط المهام" FontWeight="Medium" />
                            </CheckBox>

                            <!-- Explanatory Subtext with Fixed Padding (No truncated Arabic text!) -->
                            <Border Background="{DynamicResource Brush.Card.Background.Secondary}" 
                                    BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Padding="10,6" 
                                    Margin="0,4,0,0">
                                <TextBlock Text="عند تصغير نافذة البوت، سيتم تحويله للعمل بصمت في صينية النظام (System Tray) لتوفير موارد الجهاز ومنع التشويش أثناء اللعب." 
                                           Style="{StaticResource Style.SubText}" />
                            </Border>
                        </StackPanel>
                    </Border>


                    <!-- CARD 3: SERVER QUEUE & PENDING WINDOW -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Server}" Fill="{DynamicResource Brush.Warning}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="قائمة انتظار السيرفر (Server Pending)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>
                            </Grid>

                            <!-- Pending CheckBoxes -->
                            <CheckBox x:Name="ChkAutoHidePendingWindow" 
                                      Style="{StaticResource Style.CheckBox}"
                                      IsChecked="True" 
                                      Margin="0,0,0,8">
                                <TextBlock Text="Auto hide the pending window (إخفاء نافذة الانتظار تلقائياً)" />
                            </CheckBox>

                            <CheckBox x:Name="ChkEnableQueueLogs" 
                                      Style="{StaticResource Style.CheckBox}"
                                      IsChecked="False" 
                                      Margin="0,0,0,10">
                                <TextBlock Text="Enable pending queue logs (تفعيل سجلات الانتظار)" />
                            </CheckBox>

                            <!-- Notification Trigger Row: CheckBox + Numeric Stepper + Label -->
                            <Border Style="{StaticResource Style.Card.Subtle}" Margin="0,0,0,10" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="ChkEnableQueueNotification" 
                                              Grid.Column="0" 
                                              Style="{StaticResource Style.CheckBox}"
                                              IsChecked="True" 
                                              VerticalAlignment="Center">
                                        <TextBlock Text="Enable queue notification on (تنبيه عند اقتراب الدور)" />
                                    </CheckBox>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                        <Button x:Name="BtnQueueMinus" Style="{StaticResource Style.StepperButton}" Content="-" Margin="0,0,2,0" />
                                        <TextBox x:Name="TxtQueueLeft" 
                                                 Style="{StaticResource Style.TextBox}" 
                                                 Text="30" 
                                                 Width="36" 
                                                 Height="28" 
                                                 TextAlignment="Center" 
                                                 Padding="2,2" 
                                                 Margin="0,0,2,0" />
                                        <Button x:Name="BtnQueuePlus" Style="{StaticResource Style.StepperButton}" Content="+" Margin="0,0,6,0" />
                                        <TextBlock Text="people left" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Button: Toggle Pending Window -->
                            <Button x:Name="BtnShowPending" 
                                    Style="{StaticResource Style.Button.Secondary}" 
                                    Height="32" 
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Eye}" Fill="{DynamicResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="عرض / إخفاء نافذة الانتظار (Toggle Pending Window)" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>


                    <!-- =================================================================
                         CARD 4: TARGET & ENTITY LIVE MONITOR
                         (Fixing the isolated HP/none void by embedding it as a cohesive HUD Card!)
                         ================================================================= -->
                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,0">
                        <StackPanel>
                            <!-- Card Header with Live Radar Pulse Indicator -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.Target}" Fill="{DynamicResource Brush.Danger}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="مراقب الهدف الحالي (Target Monitor)" Style="{StaticResource Style.CardHeader}" />
                                </StackPanel>

                                <!-- Live Status Badge -->
                                <Border Grid.Column="1" 
                                        Background="{DynamicResource Brush.Card.Background.Secondary}" 
                                        BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="8,3" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TargetPulseDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtTargetStatusBadge" Text="مستهدف (Locked)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Target Name & Level / Rank Display -->
                            <Border Background="{DynamicResource Brush.Card.Background.Secondary}" 
                                    BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,8" 
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Target Entity Name -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="الهدف: " FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtTargetName" 
                                                   Text="White Tiger" 
                                                   FontWeight="Bold" 
                                                   FontSize="13.5" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Target Type / Level Badge -->
                                    <Border Grid.Column="1" 
                                            Background="{DynamicResource Brush.Danger.Subtle}" 
                                            BorderBrush="{DynamicResource Brush.Danger}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTargetTypeLevel" 
                                                   Text="Champion - Lv. 72" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource Brush.Danger}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Target HP Gauge (Smooth Gradient & Percentage Overlay) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="طاقة الهدف (Target HP):" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="TxtTargetHpDetail" 
                                               Text="100.00% (16,400 / 16,400)" 
                                               FlowDirection="LeftToRight"
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Danger}" 
                                               HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Target HP Bar Track -->
                                <Border Grid.Row="1" 
                                        Height="20" 
                                        Background="{DynamicResource Brush.Gauge.Track}" 
                                        BorderBrush="{DynamicResource Brush.Card.Border.Subtle}" 
                                        BorderThickness="1" 
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Grid>
                                        <ProgressBar x:Name="ProgressTargetHp" 
                                                     Value="85" 
                                                     Maximum="100" 
                                                     Height="20"
                                                     Foreground="{StaticResource Brush.TargetHP.Gradient}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FlowDirection="LeftToRight" />
                                        <TextBlock x:Name="TxtTargetHpOverlay" 
                                                   Text="85.00%" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="11" 
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   Effect="{StaticResource Effect.Text.Shadow}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Distance / Combat Info Strip -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Distance -->
                                <Border Grid.Column="0" Style="{StaticResource Style.StatChip}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="المسافة: " FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock x:Name="TxtTargetDistance" Text="12.4m" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Status -->
                                <Border Grid.Column="2" Style="{StaticResource Style.StatChip}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="الحالة: " FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock x:Name="TxtTargetStatus" Text="حي (Alive)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                    </StackPanel>
                                </Border>

                                <!-- Threat -->
                                <Border Grid.Column="4" Style="{StaticResource Style.StatChip}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="النوع: " FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock x:Name="TxtTargetThreat" Text="عدائي (Hostile)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
