         Shared Styles, Templates, and Geometries.
         Dynamically binds to active Palette (DarkThemeResources / LightThemeResources)
         ========================================================================= -->

    <!-- =========================================================================
         1. SHARED GRADIENTS
         ========================================================================= -->

    <!-- HP Progress Gradient -->
    <LinearGradientBrush x:Key="Brush.HP.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EF4444" Offset="0.0" />
        <GradientStop Color="#DC2626" Offset="1.0" />
    </LinearGradientBrush>

    <!-- MP Progress Gradient -->
    <LinearGradientBrush x:Key="Brush.MP.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#2563EB" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Target HP Progress Gradient -->
    <LinearGradientBrush x:Key="Brush.TargetHP.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F43F5E" Offset="0.0" />
        <GradientStop Color="#9F1239" Offset="1.0" />
    </LinearGradientBrush>


