<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AeroBot.Map</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>.\..\..\Build\Data\Plugins</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>A open source bot for Silkroad Online</Description>
    <Copyright>Copyright ©  2018 - 2024, RSBot Team</Copyright>
    <PackageProjectUrl>https://github.com/SDClowen/RSBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SDClowen/RSBot</RepositoryUrl>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" GeneratePathProperty="true" />
    <ProjectReference Include="..\..\Library\RSBot.Core\RSBot.Core.csproj" />
    <ProjectReference Include="..\..\SDUI\SDUI\SDUI.csproj" />
  </ItemGroup>

  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <ItemGroup>
      <WebView2X86 Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WebView2X86)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(WebView2X86.FullPath)')" />
    <Copy SourceFiles="@(WebView2X86)" DestinationFolder="$(TargetDir)..\..\" SkipUnchangedFiles="true" Condition="Exists('%(WebView2X86.FullPath)')" />
    <Copy SourceFiles="@(WebView2X86)" DestinationFolder="$(TargetDir)runtimes\win-x86\native\" SkipUnchangedFiles="true" Condition="Exists('%(WebView2X86.FullPath)')" />
  </Target>

  <ItemGroup>
    <Compile Update="Renderer\NavMeshRenderer.cs" />
  </ItemGroup>

</Project>
