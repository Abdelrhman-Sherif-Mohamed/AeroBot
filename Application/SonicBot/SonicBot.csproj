<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<OutputPath>.\..\..\Build</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Description>AeroBot for Silkroad Online</Description>
		<Copyright>Copyright © 2026, Abdelrhman Sherif</Copyright>
		<PackageProjectUrl>https://github.com/Abdelrhman-Sherif-Mohamed/AeroBot</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Abdelrhman-Sherif-Mohamed/AeroBot</RepositoryUrl>
		<OutputType>WinExe</OutputType>
		<AssemblyName>AeroBot</AssemblyName>
		<RootNamespace>RSBot</RootNamespace>
		<Title>AeroBot</Title>
		<Product>AeroBot</Product>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.0</FileVersion>
		<Version>1.0.0</Version>
		<ApplicationHighDpiMode></ApplicationHighDpiMode>
		<PlatformTarget>x86</PlatformTarget>
		<UseWPF>False</UseWPF>
	</PropertyGroup>

	

	<ItemGroup>
	  <Content Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Library\RSBot.Core\RSBot.Core.csproj">
		  <Private>True</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\SDUI\SDUI\SDUI.csproj" />
	</ItemGroup>
</Project>